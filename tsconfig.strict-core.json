{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".cache/typecheck-core.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    "global.d.ts",
    "middleware.ts",
    "middleware.test.ts",
    "lib/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "app/lib/**/*.ts",
    "app/api/activity/**/*.ts",
    "app/api/auth/**/*.ts",
    "app/api/identity/**/*.ts",
    "app/api/notifications/**/*.ts",
    "app/api/indexer/**/*.ts",
    "app/api/metrics/**/*.ts",
    "app/api/healthz/**/*.ts",
    "app/api/readyz/**/*.ts",
    "app/api/audit/**/*.ts",
    "app/api/exports/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "app/streams/**",
    "app/api/streams/**",
    "app/api/v2/**"
  ]
}
