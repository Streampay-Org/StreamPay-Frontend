# =============================================================================
# StreamPay Frontend Environment Configuration
# =============================================================================
#
# SECURITY NOTES:
# - Never commit real credentials or .env.local to version control
# - Use different secrets for testnet and mainnet
# - CI must use testnet only (enforced by GitHub Actions & runtime validation)
# - JWT_SECRET must be at least 32 characters in production
# - STELLAR_NETWORK is required at application boot - no silent fallback
# - All sensitive keys are automatically redacted in application logs
#
# =============================================================================
# 1. REQUIRED CORE CONFIGURATION
# =============================================================================

# Stellar Network Configuration
# Required: Yes
# Default: None
# Secret: No
# Options: testnet, mainnet, future
# Purpose: Selects which Stellar network profile to connect to
# Security: CI runner strictly enforces 'testnet'
STELLAR_NETWORK=testnet

# JWT Secret for Authentication
# Required: Yes
# Default: None in production (dev placeholder allowed only in development/test)
# Secret: Yes
# Purpose: Signs and verifies JWT tokens for wallet authentication sessions
# Security: Must be at least 32 characters long in production
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-this

# Allowed Browser Origins for Public API (CORS)
# Required: Yes
# Default: http://localhost:3000
# Secret: No
# Purpose: Comma-separated list of allowed browser origins for public API requests
# Security: Wildcard '*' is strictly forbidden in production
ALLOWED_ORIGINS=http://localhost:3000

# Node Environment Mode
# Required: No
# Default: development
# Secret: No
# Options: development, production, test
# Purpose: Controls application runtime mode, security checks, and optimizations
NODE_ENV=development

# =============================================================================
# 2. APPLICATION & SERVICE METADATA
# =============================================================================

# Service Identifier Name
# Required: No
# Default: streampay-frontend
# Secret: No
# Purpose: Identifies this service instance in structured JSON logs and OTel traces
SERVICE_NAME=streampay-frontend

# Next.js Server Runtime
# Required: No
# Default: nodejs
# Secret: No
# Options: nodejs, edge
# Purpose: Server execution runtime environment (automatically set by Next.js)
NEXT_RUNTIME=nodejs

# =============================================================================
# 3. STELLAR & SOROBAN RPC CONFIGURATION
# =============================================================================

# Stellar Horizon API URL
# Required: No
# Default: https://horizon-testnet.stellar.org (derived from STELLAR_NETWORK)
# Secret: No
# Purpose: Custom Horizon REST endpoint URL override for querying Stellar ledgers
HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC URL
# Required: No
# Default: None (e.g. https://soroban-testnet.stellar.org)
# Secret: No
# Purpose: Soroban JSON-RPC endpoint for smart contract queries and health checks
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Minimum Withdrawal Confirmation Depth
# Required: No
# Default: 3
# Secret: No
# Purpose: Minimum number of ledger confirmations before a withdrawal is final
WITHDRAWAL_MIN_CONFIRMATION_DEPTH=3

# Additional Allowed Stellar Tokens
# Required: No
# Default: (empty string - uses built-in default allowlist of native XLM and USDC)
# Secret: No
# Purpose: Comma-separated list of additional allowed asset identifiers (CODE:ISSUER)
ALLOWED_TOKENS=

# =============================================================================
# 4. STELLAR FEE-BUMP SPONSORSHIP SERVICE
# =============================================================================

# Fee-Bump Sponsor Account Secret Key
# Required: No (Fee-bump service is disabled if unset)
# Default: None
# Secret: Yes
# Purpose: Stellar secret key (starts with 'S') of account sponsoring transaction fees
FEE_BUMP_SECRET_KEY=

# Maximum Fee-Bump Amount in Stroops
# Required: No
# Default: 100000 (100,000 stroops = 0.01 XLM; hard ceiling is 10,000,000 stroops)
# Secret: No
# Purpose: Maximum transaction fee in stroops the fee-bump sponsor is willing to cover
FEE_BUMP_MAX_FEE=100000

# =============================================================================
# 5. KEY MANAGEMENT SERVICE (KMS) & SIGNING
# =============================================================================

# KMS Provider Type
# Required: No
# Default: local-mock
# Secret: No
# Options: local-mock, aws-kms
# Purpose: Selects cryptographic KMS provider (aws-kms in prod, local-mock in dev/CI)
KMS_PROVIDER=local-mock

# AWS KMS Key ID or ARN
# Required: No (Required if KMS_PROVIDER=aws-kms)
# Default: None
# Secret: No (AWS KMS key identifier or ARN)
# Purpose: KMS key used for cryptographic signing operations when using aws-kms
KMS_KEY_ID=

# AWS Region for KMS
# Required: No
# Default: us-east-1
# Secret: No
# Purpose: AWS region for AWS KMS API calls
KMS_REGION=us-east-1

# Local Mock Key Secret
# Required: No (Used only when KMS_PROVIDER=local-mock)
# Default: S_MOCK_SECRET_KEY_56_CHARS_LONG_AAAAAAAAAAAAAAAAAAAAAAA
# Secret: Yes (Mock key - never use in production)
# Purpose: Deterministic mock secret key used for local development and unit tests
STELLAR_MOCK_SECRET=S_MOCK_SECRET_KEY_56_CHARS_LONG_AAAAAAAAAAAAAAAAAAAAAAA

# =============================================================================
# 6. AUTHENTICATION, KEY ROTATION & ADMIN SECURITY
# =============================================================================

# Active JWT Key ID (kid)
# Required: No
# Default: streampay-current
# Secret: No
# Purpose: Key identifier placed into JWT header for token rotation and verification
JWT_KEY_ID=streampay-current

# Previous JWT Key ID (kid)
# Required: No
# Default: streampay-previous
# Secret: No
# Purpose: Key identifier for the previous key during rotation grace periods
JWT_PREVIOUS_KEY_ID=streampay-previous

# Previous JWT Signing Secret
# Required: No
# Default: None
# Secret: Yes
# Purpose: Previous secret used to verify unexpired tokens issued before key rotation
JWT_PREVIOUS_SECRET=

# Allow Insecure Development Secret in Production
# Required: No
# Default: false
# Secret: No
# Purpose: Emergency override flag allowing default dev JWT secret in production (dangerous)
ALLOW_INSECURE_DEV_SECRET=false

# StreamPay Admin Stellar Address
# Required: No in dev (uses dev placeholder) / Yes in production
# Default: GADMIN_DEV_PLACEHOLDER_DO_NOT_USE_IN_PROD (dev)
# Secret: No (Stellar public G-address)
# Purpose: Authorized public key for administrative operations and circuit breakers
STREAMPAY_ADMIN_ADDRESS=

# =============================================================================
# 7. INTERNAL SERVICE AUTHENTICATION & HMAC
# =============================================================================

# Deprecated Shared Internal Auth Token
# Required: No (Deprecated; rejected at startup if NODE_ENV=production)
# Default: None
# Secret: Yes
# Purpose: Legacy shared bearer token for internal service-to-service communication
INTERNAL_AUTH_TOKEN=

# Internal Service HMAC Key Map
# Required: No in dev / Recommended in production
# Default: None
# Secret: Yes (JSON object containing shared secrets at least 32 characters each)
# Purpose: Map of active and retiring HMAC key IDs to shared signing secrets
# Example: {"key-1":"secret-min-32-chars-long-aaaaaaaaaaaaa"}
INTERNAL_SERVICE_HMAC_KEYS=

# Current Active Key ID for Internal Service HMAC
# Required: No (Required if INTERNAL_SERVICE_HMAC_KEYS is configured)
# Default: None
# Secret: No
# Purpose: Identifies which key ID from INTERNAL_SERVICE_HMAC_KEYS to use when signing
INTERNAL_SERVICE_CURRENT_KEY_ID=

# Maximum Clock Skew for Internal Service HMAC Requests
# Required: No
# Default: 300 (5 minutes in seconds)
# Secret: No
# Purpose: Maximum allowed request freshness window in seconds to prevent replay attacks
INTERNAL_SERVICE_CLOCK_SKEW_SECONDS=300

# =============================================================================
# 8. WEBHOOKS CONFIGURATION
# =============================================================================

# Webhook Shared Signing Secret
# Required: No in dev (uses insecure dev placeholder) / Yes in production
# Default: dev-webhook-secret-do-not-use-in-prod-123456 (dev)
# Secret: Yes (Must be at least 32 characters in production)
# Purpose: Shared HMAC secret for verifying incoming and signing outgoing webhooks
WEBHOOK_SECRET=

# Webhook Rate Limit
# Required: No
# Default: 30 (requests per 60-second window)
# Secret: No
# Purpose: Per-user request rate limit for /api/webhooks ingest endpoints
WEBHOOK_RATE_LIMIT=30

# =============================================================================
# 9. DATABASE & PERSISTENCE
# =============================================================================

# PostgreSQL Connection String URI
# Required: No in dev / Yes for export persistence and DB health checks
# Default: None
# Secret: Yes (Contains database credentials)
# Purpose: Connection string for exports persistence and database health checks
DATABASE_URL=postgresql://streampay:streampay@localhost:5432/streampay

# =============================================================================
# 10. RECONCILIATION ENGINE
# =============================================================================

# Nightly Reconciliation Cron Bearer Secret
# Required: No in dev / Yes in production (route fails closed if unset)
# Default: None
# Secret: Yes
# Purpose: Secret bearer token authorizing scheduled nightly reconciliation cron runs
RECON_CRON_SECRET=

# Reconciliation Request Timeout
# Required: No
# Default: 30000 (30,000 milliseconds = 30 seconds)
# Secret: No
# Purpose: Per-request deadline in milliseconds for POST /api/internal/reconciliation
RECONCILIATION_TIMEOUT_MS=30000

# Reconciliation Balance Tolerance
# Required: No
# Default: 0 (exact match required)
# Secret: No
# Purpose: Allowable ledger stroop difference between database state and on-chain balance
RECONCILE_TOLERANCE=0

# Reconciliation Endpoint Rate Limit
# Required: No
# Default: 30 (requests per 60-second window)
# Secret: No
# Purpose: Per-user request rate limit for public reconciliation status endpoints
RECONCILIATION_RATE_LIMIT=30

# Reconciliation Database Dependency Health Override
# Required: No
# Default: false (or dynamic health check)
# Secret: No
# Purpose: Override flag signaling database readiness for reconciliation health checks
RECONCILIATION_DB_READY=true

# Reconciliation Soroban RPC Dependency Health Override
# Required: No
# Default: false (or dynamic health check)
# Secret: No
# Purpose: Override flag signaling RPC readiness for reconciliation health checks
RECONCILIATION_RPC_READY=true

# =============================================================================
# 11. RATE LIMITING & QUOTAS
# =============================================================================

# Rate Limit Storage Backend Type
# Required: No
# Default: in-memory
# Secret: No
# Options: in-memory, redis
# Purpose: Selects rate limiter storage adapter for tracking request windows
RATE_LIMIT_STORE_TYPE=in-memory

# Daily Stream Creation Quota Limit Per Organization
# Required: No
# Default: 100
# Secret: No
# Purpose: Maximum number of payment streams an organization can create per UTC day
ORG_DAILY_STREAM_QUOTA_LIMIT=100

# =============================================================================
# 12. REQUEST BODY SIZE LIMITS & TIMEOUTS
# =============================================================================

# Request Body Size Cap for /api/* (except webhooks)
# Required: No
# Default: 262144 (256 KB in bytes)
# Secret: No
# Purpose: Middleware rejects write requests exceeding this limit with HTTP 413
MAX_STREAM_BODY_BYTES=262144

# Request Body Size Cap for /api/webhooks*
# Required: No
# Default: 1048576 (1 MB in bytes)
# Secret: No
# Purpose: Middleware rejects webhook requests exceeding this limit with HTTP 413
MAX_WEBHOOK_BODY_BYTES=1048576

# General API Route Timeout
# Required: No
# Default: 10000 (10,000 milliseconds = 10 seconds)
# Secret: No
# Purpose: Default per-request execution timeout in milliseconds for general API routes
ROUTE_TIMEOUT_MS=10000

# Stream Operations Route Timeout
# Required: No
# Default: 5000 (5,000 milliseconds = 5 seconds)
# Secret: No
# Purpose: Per-request timeout in milliseconds for /api/v2/streams* endpoints
STREAMS_TIMEOUT_MS=5000

# Wallet Challenge Issuance Timeout
# Required: No
# Default: 5000 (5,000 milliseconds = 5 seconds)
# Secret: No
# Purpose: Per-request timeout in milliseconds for GET /api/auth/wallet
AUTH_WALLET_TIMEOUT_MS=5000

# Wallet Signature Verification Timeout
# Required: No
# Default: 5000 (5,000 milliseconds = 5 seconds)
# Secret: No
# Purpose: Per-request timeout in milliseconds for POST /api/auth/wallet
AUTH_WALLET_VERIFY_TIMEOUT_MS=5000

# Streaming Exports Route Timeout
# Required: No
# Default: 15000 (15,000 milliseconds = 15 seconds)
# Secret: No
# Purpose: Per-request timeout in milliseconds for /api/exports stream downloads
EXPORTS_TIMEOUT_MS=15000

# =============================================================================
# 13. SERVER-SENT EVENTS (SSE) & INDEXER
# =============================================================================

# SSE Keep-Alive Heartbeat Interval
# Required: No
# Default: 30000 (30,000 milliseconds = 30 seconds)
# Secret: No
# Purpose: Milliseconds between keep-alive heartbeat comment frames on SSE streams
SSE_HEARTBEAT_INTERVAL_MS=30000

# Maximum SSE Heartbeat Frames
# Required: No
# Default: 120 (approx 1 hour at 30s cadence)
# Secret: No
# Purpose: Maximum heartbeat frames before server terminates connection to prevent idle leaks
SSE_HEARTBEAT_MAX=120

# Maximum SSE Idle Silence Window
# Required: No
# Default: 120000 (120,000 milliseconds = 2 minutes)
# Secret: No
# Purpose: Maximum milliseconds of silence without write before closing dead SSE connections
SSE_MAX_IDLE_MS=120000

# Indexer Status SSE Polling Interval
# Required: No
# Default: 5000 (5,000 milliseconds = 5 seconds)
# Secret: No
# Purpose: Polling interval in milliseconds for the indexer SSE stream tick producer
SSE_INTERVAL_MS=5000

# Maximum Indexer SSE Data Events
# Required: No
# Default: 720 (approx 1 hour at 5s polling interval)
# Secret: No
# Purpose: Maximum data frames emitted per SSE connection before server closes stream
SSE_MAX_EVENTS=720

# Indexer SSE Queue Capacity
# Required: No
# Default: 64
# Secret: No
# Purpose: Buffer capacity for pending events in the indexer SSE backpressure queue
SSE_QUEUE_CAPACITY=64

# Indexer SSE Queue Overflow Policy
# Required: No
# Default: drop
# Secret: No
# Options: drop, newest, error
# Purpose: Overflow strategy when indexer SSE backpressure queue is full
SSE_QUEUE_POLICY=drop

# Indexer Stall Threshold
# Required: No
# Default: 300000 (300,000 milliseconds = 5 minutes)
# Secret: No
# Purpose: Duration in ms without ledger advancement before indexer is flagged as stalled
STALL_THRESHOLD_MS=300000

# =============================================================================
# 14. FRAUD & ANOMALY DETECTION
# =============================================================================

# Stream Creation Anomaly Burst Limit
# Required: No
# Default: 50
# Secret: No
# Purpose: Threshold for detecting anomalous bursts of stream creation calls
ANOMALY_CREATION_THRESHOLD=50

# Settle Rate Anomaly Spike Limit
# Required: No
# Default: 20
# Secret: No
# Purpose: Threshold for detecting anomalous settlement rate spikes
ANOMALY_SETTLE_THRESHOLD=20

# Stream Cancellation Anomaly Burst Limit
# Required: No
# Default: 5
# Secret: No
# Purpose: Threshold for detecting anomalous bursts of stream cancellation calls
ANOMALY_CANCEL_THRESHOLD=5

# =============================================================================
# 15. TELEMETRY, METRICS & OBSERVABILITY
# =============================================================================

# Prometheus Metrics Scraper Bearer Token
# Required: No (Endpoint returns 503 METRICS_DISABLED if unset)
# Default: None
# Secret: Yes
# Purpose: Bearer token required to scrape Prometheus metrics from GET /api/metrics
METRICS_AUTH_TOKEN=

# OpenTelemetry OTLP Collector HTTP Endpoint
# Required: No
# Default: None (OTel export disabled if unset)
# Secret: No
# Purpose: Target collector endpoint URL for OpenTelemetry traces (e.g. http://localhost:4318/v1/traces)
OTEL_EXPORTER_OTLP_ENDPOINT=

# OpenTelemetry Telemetry Consent Flag
# Required: No
# Default: denied (or unset)
# Secret: No
# Options: granted, denied
# Purpose: Explicit consent opt-in allowing telemetry traces to leave the process
STREAMPAY_TELEMETRY_CONSENT=denied

# =============================================================================
# 16. ROUTING, CANARY & FEATURE FLAGS
# =============================================================================

# Canary Traffic Percentage
# Required: No
# Default: 0
# Secret: No
# Options: 0 to 100
# Purpose: Percentage of incoming requests sampled into canary routing (adds X-Canary: true)
CANARY_PERCENTAGE=0

# Disable On-Chain Frontend Operations Flag
# Required: No
# Default: false
# Secret: No
# Purpose: Client-side flag to disable on-chain actions (top-up, cancel, withdraw) in UI
NEXT_PUBLIC_DISABLE_ONCHAIN_OPERATIONS=false

# Cache Bypass Flag
# Required: No
# Default: false (true in test)
# Secret: No
# Purpose: Disables in-memory caching across queries and account balances when set to true
STREAMPAY_CACHE_DISABLED=false

# Background Queue Worker Max Active Jobs
# Required: No
# Default: 1000
# Secret: No
# Purpose: Maximum concurrent active jobs handled simultaneously per background queue
QUEUE_MAX_ACTIVE_JOBS=1000

# =============================================================================
# 17. CHAOS & RESILIENCE TESTING (NON-PRODUCTION ONLY)
# =============================================================================

# Chaos Fault Injection Enabled Flag
# Required: No
# Default: false (Strictly ignored when NODE_ENV=production)
# Secret: No
# Purpose: Enables simulated latency and synthetic errors for testing resilience
CHAOS_ENABLED=false

# Maximum Injected Latency in Milliseconds
# Required: No
# Default: 0
# Secret: No
# Purpose: Maximum simulated delay injected into requests (delay is uniform in [0, value])
CHAOS_LATENCY_MS=0

# Chaos Synthetic Error Rate
# Required: No
# Default: 0 (range 0.0 to 1.0)
# Secret: No
# Purpose: Probability in [0, 1] of injecting a synthetic error response into requests
CHAOS_ERROR_RATE=0

# Chaos Synthetic Error HTTP Status Code
# Required: No
# Default: 503
# Secret: No
# Purpose: HTTP status code returned when a chaos error is injected (clamped to 400-599)
CHAOS_ERROR_STATUS=503

# =============================================================================
# 18. TESTING & CI ENVIRONMENTS
# =============================================================================

# Continuous Integration Flag
# Required: No (Automatically set by CI providers)
# Default: false
# Secret: No
# Purpose: When true, enforces testnet-only guardrails and blocks production secrets
CI=false

# GitHub Actions Runner Flag
# Required: No (Automatically set by GitHub Actions)
# Default: false
# Secret: No
# Purpose: When true, triggers GitHub Actions CI security policies and guardrails
GITHUB_ACTIONS=false

# Test Mode Flag
# Required: No
# Default: unset
# Secret: No
# Purpose: Enables test-only code paths and extended property-based testing suites
TEST_MODE=

