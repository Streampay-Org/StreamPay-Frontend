
# =============================================================================
# OPTIONAL WEB PUSH CONFIGURATION
# =============================================================================
#
# Push endpoints return 503 and browser push stays disabled unless all three
# values are configured. Generate the key pair once with:
#   npx web-push generate-vapid-keys
# Keep the private key in your deployment secret store; never commit its value.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@example.com
